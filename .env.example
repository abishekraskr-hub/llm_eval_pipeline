# Copy to .env and fill in. .env is gitignored; this file documents the shape.
#
# NOTE: the library's own tests and both bundled examples need NONE of these --
# they use the `fake` judge, which makes no network calls. These are only for
# running against a real app with a real judge.

# The judge, when judge.provider is `groq` (the default).
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# The judge, when judge.provider is `gemini`.
GEMINI_API_KEY=

# Run history, when storage.backend is `postgres`. The host, port, database and
# user live in llmeval.yaml; only the password belongs here.
# This is passed to libpq as a keyword parameter, so special characters need no
# escaping. Inside a URL-style DSN they would.
EVAL_PG_PASSWORD=
